digraph G { graph [rankdir=TB, bgcolor="white", pad="0.32", nodesep="0.32", ranksep="0.43", labelloc=t, label="Declarative reconciliation | lifecycle", fontname="DejaVu Sans Bold", fontsize=19, fontcolor="#183047"]; node [shape=box, style="rounded,filled", fillcolor="#F1F6FA", color="#A9BAC8", fontname="DejaVu Sans", fontsize=12, fontcolor="#183047", margin="0.22,0.14"]; edge [color="#5D7184", fontname="DejaVu Sans", fontsize=10, fontcolor="#5D7184", arrowsize=.7]; 
 start [label="Watch / periodic relist"]; valid [label="Validate resource and target Service"]; state [label="Calculate desired Deployment + Service"]; check [label="Resource exists and matches?",shape=diamond,style=filled,fillcolor="#FFF4DF",margin="0.12"]; own [label="Check ownership of existing child"]; apply [label="Create missing / update owned child",fillcolor="#E3EFFD"]; skip [label="No change needed",fillcolor="#E2F4F1"]; status [label="Update resource status when changed"]; retry [label="Report error / retry with backoff",fillcolor="#FCECE6"]; start -> valid -> state -> check; valid -> retry [label="invalid / API error"]; check -> own [label="no"]; own -> apply [label="safe to manage"]; own -> retry [label="conflict"]; check -> skip [label="yes"]; apply -> status; skip -> status; status -> start [style=dashed,label="next event",constraint=false]; retry -> start [style=dashed,constraint=false]; {rank=same; own;skip}
 }