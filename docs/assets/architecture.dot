digraph G { graph [rankdir=TB, bgcolor="white", pad="0.32", nodesep="0.32", ranksep="0.43", labelloc=t, label="CloudMesh | control plane and data plane", fontname="DejaVu Sans Bold", fontsize=19, fontcolor="#183047"]; node [shape=box, style="rounded,filled", fillcolor="#F1F6FA", color="#A9BAC8", fontname="DejaVu Sans", fontsize=12, fontcolor="#183047", margin="0.22,0.14"]; edge [color="#5D7184", fontname="DejaVu Sans", fontsize=10, fontcolor="#5D7184", arrowsize=.7]; 
 user [label="Operator / kubectl"]; cr [label="CloudMeshNetwork\nCustom resource (desired state)",fillcolor="#E3EFFD",color="#79A8DC"];
 subgraph cluster_control { label="CONTROL PLANE • Go controller"; color="#B6CCE4"; style=rounded; ctrl [label="Validate • reconcile • report status",fillcolor="#E3EFFD",color="#79A8DC"]; dep [label="Managed Deployment"]; svc [label="Managed ClusterIP Service"]; ctrl -> dep [label="create / update"]; ctrl -> svc [label="create / update"]; }
 subgraph cluster_data { label="DATA PLANE • CloudMesh proxy"; color="#A7D8D2"; style=rounded; disc [label="EndpointSlice discovery"]; pool [label="Concurrent backend pool\nRound robin / least connections / hash"]; px [label="TCP forwarding | HTTP reverse proxy",fillcolor="#E2F4F1",color="#6CBAB0"]; disc -> pool; pool -> px [label="select backend"]; }
 user -> cr [label="apply / patch"]; cr -> ctrl [label="list / watch"]; ctrl -> cr [style=dashed,label="status",constraint=false]; dep -> px [label="pod replicas"]; client [label="Client (localhost port-forward)"]; client -> svc [label="select managed pod",style=dashed]; svc -> px; es [label="Kubernetes EndpointSlices\nfor echo Service"]; es -> disc; echo [label="Echo pods • 3 backends",fillcolor="#E2F4F1"]; px -> echo [label="application traffic"]; {rank=same; user;client} {rank=same; svc;es}
 }