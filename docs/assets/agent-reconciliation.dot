digraph G {
graph [bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.40", labelloc=t, fontname="DejaVu Sans Bold", fontsize=19, fontcolor="#183047"]; node [shape=box, style="rounded,filled", fillcolor="#F1F6FA", color="#A9BAC8", fontname="DejaVu Sans", fontsize=12, fontcolor="#183047", margin="0.19,0.13"]; edge [color="#5D7184", fontname="DejaVu Sans", fontsize=10, fontcolor="#5D7184", arrowsize=.75];
 graph [label="Linux agent | reconciliation loop"];

 config [label="Read JSON and validate VNI / port"]; desired [label="Allocate deterministic dual-stack addresses\nCalculate desired resources"]; inspect [label="Inspect namespaces, links, addresses and rules"]; equal [shape=diamond,label="Match?",fillcolor="#E3EFFD"]; apply [label="Apply only required mutations\nOrdered network / firewall / NAT operations"]; noop [label="No mutations\nchanges=0",fillcolor="#E2F4F1"]; err [label="Report partial changes and error",fillcolor="#FCE8DB"]; sleep [label="Wait for interval (continuous mode)"]; config -> desired -> inspect -> equal; equal -> noop [label="yes"]; equal -> apply [label="no"]; apply -> sleep [label="success"]; apply -> err [label="failure"]; err -> sleep; noop -> sleep; sleep -> config [label="retry / refresh",constraint=false]; {rank=same;noop;apply}

}
